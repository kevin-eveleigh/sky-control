# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/

# next.js
/.next/
/out/
/build/
/dist/

# misc
.DS_Store
*.pem
*.swp
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the example is the template the README tells you to copy,
# so it is the one env file that must stay in the repository
.env*
!.env.example

# typescript
next-env.d.ts
*.tsbuildinfo

# runtime state, not source: the airco list is written by the app and holds
# this network's addresses and MAC addresses
/data/

# protocol captures are local research material, often large
/captures/*
!/captures/.gitkeep

# service logs
/.logs/*
!/.logs/.gitkeep

# locally downloaded issue reports (review before attaching outside the repo)
*-diagnostics.json

# editor / agent local settings (launch.json is shared on purpose)
.claude/settings.local.json
.vscode/
.idea/

# vercel
.vercel
