# Sky Control is local-only. Never port-forward this service or expose it
# directly to the public internet. Use a private VPN such as WireGuard.

# Bridge listener. 0.0.0.0 allows phones on the same LAN to connect.
SKY_CONTROL_HOST=0.0.0.0
SKY_CONTROL_PORT=3000

# Recommended for any shared LAN or VPN. Generate a secret with:
#   openssl rand -hex 32
# AIRCO_TOKEN=

# Optional first-device seed. Leave unset to use discovery or manual setup.
# AIRCO_HOST=ac.local
# AIRCO_PORT=1998

# Runtime state paths. These files contain local identifiers and stay ignored.
# AIRCO_CONFIG_PATH=data/aircos.json
# AIRCO_SETTINGS_PATH=data/settings.json

# Optional comma-separated origins accepted by `npm run dev` when developing
# from another local hostname. Production does not use this setting.
# SKY_CONTROL_ALLOWED_DEV_ORIGINS=dev-mac.local
