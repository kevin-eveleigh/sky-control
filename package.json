{
  "name": "sky-control",
  "version": "0.1.0",
  "description": "Local-first control for air conditioners using the Skyworth SWM100 protocol.",
  "license": "MIT",
  "private": true,
  "skyControl": {
    "displayName": "Sky Control",
    "serviceSlug": "sky-control",
    "serviceId": "com.{user}.sky-control"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node support/build.mjs",
    "start": "node support/start.mjs",
    "service:deploy": "zsh support/service.sh install",
    "service:install": "zsh support/service.sh install",
    "service:status": "zsh support/service.sh status",
    "service:restart": "zsh support/service.sh restart",
    "service:uninstall": "zsh support/service.sh uninstall",
    "test": "node --import tsx --test tests/index.mjs",
    "lint": "eslint . --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
