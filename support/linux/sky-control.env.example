# Sky Control on Linux. Install as /etc/sky-control.env (root:skycontrol, 640)
# and restart the service after changes: sudo systemctl restart sky-control
#
# Never port-forward this service or expose it directly to the public internet.

# Loopback only, for a server reached through a private proxy such as
# `tailscale serve` (see docs/remote-server.md). On a machine at home, 0.0.0.0
# lets phones on the same trusted Wi-Fi connect directly.
SKY_CONTROL_HOST=127.0.0.1
SKY_CONTROL_PORT=3000

# Recommended for any VPN deployment. Generate a secret with:
#   openssl rand -hex 32
# AIRCO_TOKEN=

# Optional first-device seed. Units can also be added in the web page.
# AIRCO_HOST=192.168.1.50
# AIRCO_PORT=1998

# Device state lives outside the checkout so updates never touch it.
AIRCO_CONFIG_PATH=/var/lib/sky-control/aircos.json
AIRCO_SETTINGS_PATH=/var/lib/sky-control/settings.json
NODE_ENV=production
